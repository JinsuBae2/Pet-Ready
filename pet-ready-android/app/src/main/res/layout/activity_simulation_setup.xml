<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_warm_blue">

    <View
        android:layout_width="270dp"
        android:layout_height="270dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-92dp"
        android:layout_marginTop="-76dp"
        android:alpha="0.7"
        android:background="@drawable/bg_login_bubble_large" />

    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="-86dp"
        android:alpha="0.52"
        android:background="@drawable/bg_login_bubble_large" />

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-76dp"
        android:layout_marginBottom="34dp"
        android:alpha="0.38"
        android:background="@drawable/bg_login_bubble_blue" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="46dp"
            android:paddingEnd="22dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="펫 생성"
                android:textColor="@color/pet_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="함께 돌볼 반려견 로봇의 정보를 정해주세요."
                android:textColor="@color/pet_text_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_login_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="30dp"
                android:paddingEnd="30dp"
                android:paddingBottom="30dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="이름"
                    android:textColor="@color/pet_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etSetupPetName"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_login_input"
                    android:hint="예: 몽치"
                    android:singleLine="true"
                    android:textColor="@color/pet_text"
                    android:textColorHint="@color/pet_text_muted"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="진행 기간"
                    android:textColor="@color/pet_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnOneWeek"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_robot_secondary_button"
                        android:backgroundTint="@null"
                        android:text="1주"
                        android:textAllCaps="false"
                        android:textColor="@color/pet_primary_dark"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnTwoWeeks"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_robot_secondary_button"
                        android:backgroundTint="@null"
                        android:text="2주"
                        android:textAllCaps="false"
                        android:textColor="@color/pet_primary_dark"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnThreeWeeks"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_login_primary_button"
                        android:backgroundTint="@null"
                        android:text="3주"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStartSimulation"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_login_primary_button"
                    android:backgroundTint="@null"
                    android:text="펫 생성하기"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
