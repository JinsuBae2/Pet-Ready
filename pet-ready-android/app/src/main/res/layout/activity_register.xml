<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="5dp"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/btnRegisterBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹"
            android:textColor="@color/pet_text"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="회원가입"
            android:textColor="@color/pet_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="펫을 위한 가족 계정을 만들고 로봇과 연결해 주세요."
            android:textColor="@color/pet_text_muted"
            android:textSize="15sp" />

        <TextView
            style="@style/RegisterFieldLabel"
            android:layout_marginTop="28dp"
            android:text="이름" />

        <EditText
            android:id="@+id/etNickname"
            style="@style/RegisterEditText"
            android:hint="이름을 입력하세요" />

        <TextView
            style="@style/RegisterFieldLabel"
            android:text="이메일" />

        <EditText
            android:id="@+id/etRegisterEmail"
            style="@style/RegisterEditText"
            android:hint="이메일을 입력하세요"
            android:inputType="textEmailAddress" />

        <TextView
            style="@style/RegisterFieldLabel"
            android:text="비밀번호" />

        <EditText
            android:id="@+id/etRegisterPassword"
            style="@style/RegisterEditText"
            android:hint="비밀번호를 입력하세요"
            android:inputType="textPassword" />

        <TextView
            style="@style/RegisterFieldLabel"
            android:text="비밀번호 확인" />

        <EditText
            android:id="@+id/etRegisterPasswordConfirm"
            style="@style/RegisterEditText"
            android:hint="비밀번호를 다시 입력하세요"
            android:inputType="textPassword" />

        <CheckBox
            android:id="@+id/checkRegisterTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:buttonTint="@color/pet_primary"
            android:text="이용약관 및 개인정보 처리방침에 동의합니다."
            android:textColor="@color/pet_text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSubmitRegister"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_pill"
            android:backgroundTint="@null"
            android:text="회원가입"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <TextView
            android:id="@+id/tvRegisterResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="계정 정보를 입력해주세요."
            android:textColor="@color/pet_text_muted"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
