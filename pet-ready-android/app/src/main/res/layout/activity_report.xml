<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="양육 리포트"
            android:textColor="@color/pet_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="점수는 100점에서 시작하고, 돌봄·산책·미션 결과에 따라 내려가요."
            android:textColor="@color/pet_text_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_report_paper"
            android:elevation="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFinalScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="종합 점수"
                android:textColor="@color/pet_text"
                android:textSize="32sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCareScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="건강 점수"
                android:textColor="@color/pet_text"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressCareScore"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="@color/pet_primary" />

            <TextView
                android:id="@+id/tvWalkScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="산책 점수"
                android:textColor="@color/pet_text"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressWalkScore"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="@color/pet_primary" />

            <TextView
                android:id="@+id/tvMissionScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="응답 점수"
                android:textColor="@color/pet_text"
                android:textSize="16sp" />

            <ProgressBar
                android:id="@+id/progressMissionScore"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progressTint="@color/pet_primary" />

            <TextView
                android:id="@+id/tvReportComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="코멘트"
                android:textColor="@color/pet_text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFinalReportNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_report_paper"
            android:elevation="5dp"
            android:lineSpacingExtra="4dp"
            android:text="최종 리포트는 3주 사용 기간이 끝난 뒤 서버 분석 결과로 제공됩니다. Weka 성향 분석, 맞춤 품종 추천, 공공데이터 기반 메시지와 추천 유기견 정보가 이곳에 표시됩니다."
            android:textColor="@color/pet_text"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:elevation="5dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="점수 이벤트"
                android:textColor="@color/pet_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutScoreEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
