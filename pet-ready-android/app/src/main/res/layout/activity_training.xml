<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/btnTrainingBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="@color/pet_text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="반려견 훈련"
        android:textColor="@color/pet_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="카메라가 SIT 또는 STAY 제스처를 감지한 뒤 60초 안에 간식을 주세요."
        android:textColor="@color/pet_text_muted"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvTrainingDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_home_chip"
        android:padding="12dp"
        android:textColor="@color/pet_primary_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTrainingStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:minHeight="180dp"
        android:padding="20dp"
        android:text="제스처를 확인한 뒤 간식 주기 버튼을 눌러주세요."
        android:textColor="@color/pet_text"
        android:textSize="17sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnGiveTrainingReward"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_primary_pill"
        android:backgroundTint="@null"
        android:text="간식 주기"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />
</LinearLayout>
