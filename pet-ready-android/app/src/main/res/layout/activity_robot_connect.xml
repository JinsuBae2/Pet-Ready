<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_warm_blue">

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-86dp"
        android:layout_marginTop="-62dp"
        android:alpha="0.72"
        android:background="@drawable/bg_login_bubble_large" />

    <View
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="-84dp"
        android:alpha="0.52"
        android:background="@drawable/bg_login_bubble_large" />

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-72dp"
        android:layout_marginBottom="20dp"
        android:alpha="0.42"
        android:background="@drawable/bg_login_bubble_blue" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="46dp"
            android:paddingEnd="22dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="기기 연결"
                    android:textColor="@color/pet_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="반려견 로봇과 앱을 연결하고\n실시간 상태를 확인해요."
                    android:textColor="@color/pet_text_muted"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_login_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:paddingStart="30dp"
                android:paddingTop="30dp"
                android:paddingEnd="30dp"
                android:paddingBottom="30dp">

                <TextView
                    android:id="@+id/tvConnectStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_robot_status_soft"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="로봇 연결 상태 확인 중..."
                    android:textColor="@color/pet_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCheckRobot"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_login_primary_button"
                    android:backgroundTint="@null"
                    android:text="다시 확인하기"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnQrConnect"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_robot_secondary_button"
                    android:backgroundTint="@null"
                    android:text="QR 코드로 연결"
                    android:textAllCaps="false"
                    android:textColor="@color/pet_primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
