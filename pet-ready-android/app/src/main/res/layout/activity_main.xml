<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="34dp"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLoginTitlePet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="펫"
                        android:textColor="#0F8FAE"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLoginTitleReady"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-rounded"
                        android:text="레디"
                        android:textColor="@color/pet_primary"
                        android:textSize="48sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="26dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-4dp"
                    android:layout_marginStart="-6dp"
                    android:contentDescription="펫 레디 로고"
                    android:src="@drawable/ic_paw_logo_blue" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvLoginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-rounded"
                android:text="PET READY"
                android:textColor="#93A4B8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoginCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="반려견 로봇과 오늘의 돌봄을 시작해요"
                android:textColor="@color/pet_text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:elevation="5dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_input"
                android:hint="이메일"
                android:inputType="textEmailAddress"
                android:textColor="@color/pet_text"
                android:textColorHint="@color/pet_text_muted" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:hint="비밀번호"
                android:inputType="textPassword"
                android:textColor="@color/pet_text"
                android:textColorHint="@color/pet_text_muted" />

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_primary_pill"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="로그인"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGoRegister"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_secondary_pill"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="회원가입"
                android:textAllCaps="false"
                android:textColor="@color/pet_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDemoDashboard"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary_pill"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="데모로 시작하기"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="로그인 후 기기 연결 상태를 확인합니다."
                android:textColor="@color/pet_text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
