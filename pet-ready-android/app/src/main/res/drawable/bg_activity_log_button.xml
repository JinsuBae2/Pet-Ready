<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#BFDBFE" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#60A5FA" />
            <padding
                android:bottom="12dp"
                android:left="18dp"
                android:right="18dp"
                android:top="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#DBEAFE" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#93C5FD" />
            <padding
                android:bottom="12dp"
                android:left="18dp"
                android:right="18dp"
                android:top="12dp" />
        </shape>
    </item>
</selector>
