<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:top="4dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape>
            <solid android:color="#0D4A3B32" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Main Card Body -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="4dp">
        <shape>
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/pet_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
