<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Very soft shadow for completed item -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
        <shape>
            <solid android:color="#054A3B32" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Main Card Body -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
        <shape>
            <solid android:color="#FFF9F3" />
            <stroke
                android:width="1dp"
                android:color="#FFEAD2" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
