<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft shadow -->
    <item android:top="6dp" android:left="3dp" android:right="3dp" android:bottom="0dp">
        <shape>
            <solid android:color="#0F4A3B32" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Main Card Body -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="6dp">
        <shape>
            <gradient
                android:angle="0"
                android:endColor="#FFFDF0"
                android:centerColor="#FFF2E6"
                android:startColor="#FFEAD2" />
            <stroke
                android:width="1dp"
                android:color="#FFEAD2" />
            <corners android:radius="24dp" />
            <padding
                android:bottom="18dp"
                android:left="18dp"
                android:right="18dp"
                android:top="18dp" />
        </shape>
    </item>
</layer-list>
