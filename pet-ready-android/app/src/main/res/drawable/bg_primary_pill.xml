<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#26FF7A00" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
                <shape>
                    <solid android:color="@color/pet_primary_dark" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#FFF0E0" />
                    <padding
                        android:bottom="10dp"
                        android:left="16dp"
                        android:right="16dp"
                        android:top="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp" android:left="3dp" android:right="3dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#40FF7A00" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="5dp">
                <shape>
                    <solid android:color="@color/pet_primary" />
                    <corners android:radius="16dp" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FFEAD2" />
                    <padding
                        android:bottom="10dp"
                        android:left="16dp"
                        android:right="16dp"
                        android:top="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
