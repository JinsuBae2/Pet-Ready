<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/pet_primary_dark" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="10dp"
                android:left="16dp"
                android:right="16dp"
                android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/pet_primary" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="10dp"
                android:left="16dp"
                android:right="16dp"
                android:top="10dp" />
        </shape>
    </item>
</selector>
