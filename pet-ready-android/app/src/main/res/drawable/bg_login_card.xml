<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Offset Soft Card Shadow -->
    <item android:top="6dp" android:left="3dp" android:right="3dp" android:bottom="0dp">
        <shape>
            <solid android:color="#0F4A3B32" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Main Card Body -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="6dp">
        <shape>
            <solid android:color="@color/pet_surface" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/pet_border" />
        </shape>
    </item>
</layer-list>
