<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Offset Soft Shadow -->
    <item android:top="5dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape>
            <solid android:color="#0F4A3B32" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <!-- Main Card Body -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="5dp">
        <shape>
            <solid android:color="#FFF2E6" />
            <stroke
                android:width="1dp"
                android:color="@color/pet_border" />
            <corners android:radius="18dp" />
            <padding
                android:bottom="14dp"
                android:left="12dp"
                android:right="12dp"
                android:top="14dp" />
        </shape>
    </item>
</layer-list>
