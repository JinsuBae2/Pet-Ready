<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle soft shadow -->
    <item android:top="2dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
        <shape>
            <solid android:color="#0F4A3B32" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Main Body -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
        <shape>
            <solid android:color="@color/pet_lavender" />
            <stroke
                android:width="1dp"
                android:color="@color/pet_border" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="10dp"
                android:left="14dp"
                android:right="14dp"
                android:top="10dp" />
        </shape>
    </item>
</layer-list>
