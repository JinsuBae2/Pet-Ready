<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft warm orange shadow -->
    <item android:top="6dp" android:left="3dp" android:right="3dp" android:bottom="0dp">
        <shape>
            <solid android:color="#1DFF7A00" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- Main Card Body -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="6dp">
        <shape>
            <gradient
                android:angle="315"
                android:endColor="#FF7A00"
                android:centerColor="#FFC107"
                android:startColor="#FFF2E6" />
            <stroke
                android:width="1dp"
                android:color="#FFEAD2" />
            <corners android:radius="26dp" />
            <padding
                android:bottom="20dp"
                android:left="20dp"
                android:right="20dp"
                android:top="20dp" />
        </shape>
    </item>
</layer-list>
