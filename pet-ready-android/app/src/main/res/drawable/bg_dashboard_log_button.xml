<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#26FF7A00" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="2dp">
                <shape>
                    <gradient
                        android:angle="135"
                        android:endColor="#CC6200"
                        android:startColor="#E66E00" />
                    <corners android:radius="22dp" />
                    <stroke
                        android:width="1dp"
                        android:color="#FFF0E0" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="5dp" android:left="3dp" android:right="3dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#40FF7A00" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="5dp">
                <shape>
                    <gradient
                        android:angle="135"
                        android:endColor="#FF7A00"
                        android:startColor="#FFC107" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#FFEAD2" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
