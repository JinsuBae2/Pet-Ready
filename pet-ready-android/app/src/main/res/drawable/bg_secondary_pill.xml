<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#FFEAD2" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/pet_accent" />
                    <corners android:radius="16dp" />
                    <padding
                        android:bottom="10dp"
                        android:left="16dp"
                        android:right="16dp"
                        android:top="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- subtle drop shadow -->
            <item android:top="3dp" android:left="1.5dp" android:right="1.5dp" android:bottom="0dp">
                <shape>
                    <solid android:color="#1A4A3B32" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <!-- main body -->
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="3dp">
                <shape>
                    <solid android:color="@color/pet_lavender" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/pet_border" />
                    <corners android:radius="16dp" />
                    <padding
                        android:bottom="10dp"
                        android:left="16dp"
                        android:right="16dp"
                        android:top="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
