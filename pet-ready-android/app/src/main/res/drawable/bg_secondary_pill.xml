<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#BFDBFE" />
            <stroke
                android:width="1dp"
                android:color="@color/pet_accent" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="10dp"
                android:left="16dp"
                android:right="16dp"
                android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/pet_lavender" />
            <stroke
                android:width="1dp"
                android:color="@color/pet_border" />
            <corners android:radius="16dp" />
            <padding
                android:bottom="10dp"
                android:left="16dp"
                android:right="16dp"
                android:top="10dp" />
        </shape>
    </item>
</selector>
